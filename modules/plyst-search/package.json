{
  "name": "plyst-search",
  "version": "1.0.0",
  "private": true,
  "description": "Plyst 검색 계산 Rust 코어와 C++ TurboModule",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "codegenConfig": {
    "name": "PlystSearchSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "opfic.plyst.search"
    },
    "ios": {
      "modules": {
        "PlystSearch": {
          "className": "PlystSearchModuleProvider"
        }
      }
    }
  },
  "peerDependencies": {
    "react-native": "0.86.3"
  }
}
