XCODE_PROJ = "Plyst/Plyst.xcodeproj"
SCHEME = "Plyst"
CONFIGURATION = "Release"
APP_IDENTIFIER = "opfic.Plyst"
APP_TARGET_NAME = "Plyst"
APP_PRODUCT_NAME = "Plyst"
EXTENSION_TARGETS = {
  "ShareExtension" => "opfic.Plyst.ShareExtension",
  "WidgetExtension" => "opfic.Plyst.WidgetExtension"
}
APP_IDENTIFIERS = [APP_IDENTIFIER, *EXTENSION_TARGETS.values]
TESTFLIGHT_BUILD_OUTPUT_DIRECTORY = File.expand_path("testflight_build", __dir__)
TESTFLIGHT_IPA_OUTPUT_PATH = File.join(TESTFLIGHT_BUILD_OUTPUT_DIRECTORY, "#{APP_PRODUCT_NAME}.ipa")
APPSTORE_BUILD_OUTPUT_DIRECTORY = File.expand_path("appstore_build", __dir__)
APPSTORE_IPA_OUTPUT_PATH = File.join(APPSTORE_BUILD_OUTPUT_DIRECTORY, "#{APP_PRODUCT_NAME}.ipa")

# xcodeproj 1.27은 Xcode 27의 확장 복사 위치(dstSubfolder)를 모르면 프로젝트를 저장할 때 지운다.
# 확장이 앱의 PlugIns가 아닌 아카이브 루트에 설치되므로 프로젝트를 여는 어떤 액션보다 먼저 속성을 등록한다.
require "xcodeproj"
copy_phase = Xcodeproj::Project::Object::PBXCopyFilesBuildPhase
unless copy_phase.method_defined?(:dst_subfolder)
  copy_phase.class_eval { attribute :dst_subfolder, String }
end

# 앱 타깃의 MARKETING_VERSION을 읽고 App Store 버전 형식을 검증한다.
def marketing_version_from_project
  version_number = get_version_number(
    xcodeproj: XCODE_PROJ,
    target: APP_TARGET_NAME,
    configuration: CONFIGURATION
  ).to_s.strip

  UI.user_error!("Missing MARKETING_VERSION in #{XCODE_PROJ}") if version_number.empty?

  if !version_number.match?(/\A[1-9]\d*(?:\.\d+){0,2}\z/)
    UI.user_error!(
      "Invalid MARKETING_VERSION in #{XCODE_PROJ}: #{version_number.inspect}. Expected one to three dot-separated integers beginning with a positive integer."
    )
  end

  version_number
end

default_platform(:ios)

platform :ios do
  private_lane :fetch_latest_app_store_connect_build_number do |options|
    require "spaceship"

    api_key = options[:api_key]
    version_number = options[:version]

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("Could not find app for #{APP_IDENTIFIER}") if app.nil?

    filter = {
      "state" => "PROCESSING,FAILED,COMPLETE",
      "cfBundleShortVersionString" => version_number,
      "platform" => Spaceship::ConnectAPI::Platform.map("ios")
    }

    build = Spaceship::ConnectAPI.get_build_uploads(
      app_id: app.id,
      filter: filter,
      sort: "-uploadedDate",
      limit: 1
    ).first

    next 0 if build.nil?

    next build.cf_build_version.to_i
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      in_house: false
    )
  end

  private_lane :required_plist_value do |options|
    require "shellwords"

    path = options[:path]
    source = options[:source]
    key = options[:key]

    value = begin
      sh(
        "/usr/libexec/PlistBuddy -c 'Print :#{key}' #{Shellwords.escape(path)}",
        log: false
      ).strip
    rescue StandardError
      UI.user_error!("Missing #{key} in #{source} at #{path}")
    end

    UI.user_error!("Empty #{key} in #{source} at #{path}") if value.empty?

    next value
  end

  private_lane :verify_plist_value do |options|
    actual_value = required_plist_value(
      path: options[:path],
      source: options[:source],
      key: options[:key]
    )
    expected_value = options[:expected].to_s.strip

    UI.user_error!("Missing expected #{options[:key]}") if expected_value.empty?

    if actual_value != expected_value
      UI.user_error!(
        "Unexpected #{options[:key]} in #{options[:source]}: expected #{expected_value}, got #{actual_value}"
      )
    end

    UI.message("Verified #{options[:key]} in #{options[:source]}")
  end

  private_lane :verify_store_info_plist do |options|
    require "shellwords"
    require "tmpdir"

    ipa_path = options[:ipa]

    UI.user_error!("Missing IPA path") if ipa_path.to_s.strip.empty?
    UI.user_error!("Missing built ipa at #{ipa_path}") if !File.exist?(ipa_path)

    Dir.mktmpdir("plyst-ipa") do |tmpdir|
      sh("unzip -q #{Shellwords.escape(ipa_path)} -d #{Shellwords.escape(tmpdir)}")

      app_path = File.join(tmpdir, "Payload", "#{APP_PRODUCT_NAME}.app")
      plist_path = File.join(app_path, "Info.plist")
      UI.user_error!("Missing app Info.plist in ipa") if !File.exist?(plist_path)

      verify_plist_value(
        path: plist_path,
        source: "app Info.plist",
        key: "CFBundleIdentifier",
        expected: APP_IDENTIFIER
      )

      verify_plist_value(
        path: plist_path,
        source: "app Info.plist",
        key: "ITSAppUsesNonExemptEncryption",
        expected: false
      )

      verify_embedded_react_native(app_path: app_path)

      EXTENSION_TARGETS.each do |target_name, bundle_identifier|
        extension_plist_path = File.join(app_path, "PlugIns", "#{target_name}.appex", "Info.plist")
        UI.user_error!("Missing #{target_name} Info.plist in ipa") if !File.exist?(extension_plist_path)

        verify_plist_value(
          path: extension_plist_path,
          source: "#{target_name} Info.plist",
          key: "CFBundleIdentifier",
          expected: bundle_identifier
        )
      end
    end
  end

  # ReactBrownfield와 PlystBridge는 정적으로 링크되므로 IPA 임베딩 대상에서 제외한다.
  private_lane :verify_embedded_react_native do |options|
    require "shellwords"

    manifest = File.read(File.expand_path("../Plyst/Packages/PlystReactNative/Package.swift", __dir__))
    names = manifest.match(/let frameworkNames = \[(.*?)\]/m)[1].scan(/"([^"]+)"/).flatten
    dynamic_names = names - ["ReactBrownfield", "PlystBridge"]

    dynamic_names.each do |name|
      binary = File.join(options[:app_path], "Frameworks", "#{name}.framework", name)
      UI.user_error!("Missing embedded RN framework binary: #{binary}") unless File.file?(binary)
      header = sh("otool -hv #{Shellwords.escape(binary)}", log: false)
      UI.user_error!("Expected an arm64 dynamic RN framework: #{name}") unless header.include?("ARM64") && header.include?("DYLIB")
    end

    bundle = File.join(options[:app_path], "Frameworks", "BrownfieldLib.framework", "main.jsbundle")
    UI.user_error!("Missing or empty distribution main.jsbundle: #{bundle}") unless File.file?(bundle) && File.size?(bundle)
  end

  private_lane :verify_release_xcframeworks do
    directory = File.expand_path("../Plyst/Packages/PlystReactNative/Frameworks", __dir__)
    marker = File.join(directory, ".configuration")
    unless File.file?(marker) && File.read(marker).strip == CONFIGURATION
      UI.user_error!("Run make rn-xcframework RN_CONFIGURATION=Release before distribution")
    end
  end

  # App Store Connect는 널리 쓰이는 서드파티 SDK(SDWebImage 등)에 서명을 요구하므로 XCFramework를 배포 인증서로 서명한다.
  # 같은 팀의 인증서가 여러 개면 첫 번째를 쓴다.
  private_lane :sign_xcframeworks do |options|
    require "shellwords"

    team_id = options[:team_id].to_s
    identities = sh("security find-identity -v -p codesigning", log: false)
    identity = identities.lines.grep(/Apple Distribution:.*\(#{Regexp.escape(team_id)}\)/).first.to_s[/\h{40}/]
    UI.user_error!("Missing Apple Distribution identity for team #{team_id}") if identity.nil?

    directory = File.expand_path("../Plyst/Packages/PlystReactNative/Frameworks", __dir__)
    Dir.glob(File.join(directory, "*.xcframework")).sort.each do |xcframework|
      sh("codesign --force --timestamp --sign #{identity} #{Shellwords.escape(xcframework)}")
    end
  end

  private_lane :build_for_store do |options|
    output_directory = options[:output_directory] || TESTFLIGHT_BUILD_OUTPUT_DIRECTORY

    if ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"].to_s.strip.empty?
      ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "30"
    end

    if ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"].to_s.strip.empty?
      ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "5"
    end

    verify_release_xcframeworks

    api_key = asc_api_key

    version_number = marketing_version_from_project

    latest_build_number = fetch_latest_app_store_connect_build_number(
      api_key: api_key,
      version: version_number
    )

    setup_ci if ENV["CI"]

    next_build_number = latest_build_number + 1

    match(
      api_key: api_key,
      type: "appstore",
      app_identifier: APP_IDENTIFIERS,
      readonly: true
    )

    if ENV["CI"] == "true" || ENV["LOCAL_DEPLOY"] == "true"
      profile_mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
      signing_targets = {
        APP_TARGET_NAME => APP_IDENTIFIER,
        **EXTENSION_TARGETS
      }

      signing_targets.each do |target_name, app_identifier|
        provisioning_profile_specifier = profile_mapping[app_identifier].to_s
        UI.user_error!("Missing App Store provisioning profile mapping for #{app_identifier}") if provisioning_profile_specifier.empty?

        update_code_signing_settings(
          use_automatic_signing: false,
          path: XCODE_PROJ,
          sdk: "iphoneos*",
          team_id: ENV["APP_STORE_TEAM_ID"],
          targets: [target_name],
          build_configurations: [CONFIGURATION],
          code_sign_identity: "Apple Distribution",
          profile_name: provisioning_profile_specifier
        )
      end
    end

    sign_xcframeworks(team_id: ENV["APP_STORE_TEAM_ID"])

    # 빌드 번호는 프로젝트 파일을 수정하지 않고 앱과 확장 타깃 전체에 빌드 설정으로 주입한다.
    archive_started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    build_app(
      project: XCODE_PROJ,
      scheme: SCHEME,
      configuration: CONFIGURATION,
      export_method: "app-store",
      output_directory: output_directory,
      output_name: "#{APP_PRODUCT_NAME}.ipa",
      include_symbols: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build_number} DEBUG_INFORMATION_FORMAT=dwarf-with-dsym -skipPackagePluginValidation -skipMacroValidation"
    )
    archive_duration_seconds = Process.clock_gettime(Process::CLOCK_MONOTONIC) - archive_started_at
    UI.message("Archive duration seconds: #{archive_duration_seconds}")

    github_output = ENV["GITHUB_OUTPUT"].to_s
    unless github_output.empty?
      File.open(github_output, "a") do |output|
        output.puts("archive_duration_seconds=#{archive_duration_seconds}")
      end
    end

    ipa_output_path = lane_context[SharedValues::IPA_OUTPUT_PATH].to_s
    ipa_output_path = File.join(output_directory, "#{APP_PRODUCT_NAME}.ipa") if ipa_output_path.empty?

    verify_store_info_plist(ipa: ipa_output_path)

    dsym_output_path = lane_context[SharedValues::DSYM_OUTPUT_PATH]
    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    UI.message("dSYM output path: #{dsym_output_path}") unless dsym_output_path.to_s.empty?
    UI.message("Xcode archive path: #{archive_path}") unless archive_path.to_s.empty?

    unless github_output.empty?
      File.open(github_output, "a") do |output|
        output.puts("ipa_size_bytes=#{File.size(ipa_output_path)}") if File.file?(ipa_output_path)
        if File.file?(dsym_output_path.to_s) && dsym_output_path.to_s.end_with?(".dSYM.zip")
          output.puts("dsym_size_bytes=#{File.size(dsym_output_path)}")
        end
      end
    end

    next api_key
  end

  lane :deploy_testflight do
    build_for_store(output_directory: TESTFLIGHT_BUILD_OUTPUT_DIRECTORY)

    upload_testflight_build
  end

  lane :testflight_build_only do
    build_for_store(output_directory: TESTFLIGHT_BUILD_OUTPUT_DIRECTORY)
  end

  lane :appstore_build_only do
    build_for_store(output_directory: APPSTORE_BUILD_OUTPUT_DIRECTORY)
  end

  lane :deploy_appstore do
    build_for_store(output_directory: APPSTORE_BUILD_OUTPUT_DIRECTORY)

    upload_appstore_build
  end

  lane :sync_appstore_profiles do
    unless ENV["GITHUB_EVENT_NAME"] == "workflow_dispatch" && ENV["GITHUB_WORKFLOW"] == "iOS Code Signing"
      UI.user_error!("Profile updates require a manual iOS Code Signing workflow dispatch")
    end

    api_key = asc_api_key
    match_force = ENV.fetch("MATCH_FORCE", "false") == "true"

    setup_ci if ENV["CI"]

    match(
      api_key: api_key,
      type: "appstore",
      app_identifier: APP_IDENTIFIERS,
      force: match_force,
      readonly: false
    )
  end

  lane :upload_testflight_build do
    api_key = asc_api_key
    # lane_context는 같은 fastlane 실행 내에서만 유지되므로 별도 CI step에서는 고정 ipa 경로를 사용한다.
    ipa_output_path = lane_context[SharedValues::IPA_OUTPUT_PATH].to_s
    ipa_output_path = TESTFLIGHT_IPA_OUTPUT_PATH if ipa_output_path.empty?

    UI.user_error!("Missing built ipa at #{ipa_output_path}") if !File.exist?(ipa_output_path)

    verify_store_info_plist(ipa: ipa_output_path)

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_output_path,
      skip_waiting_for_build_processing: true
    )
  end

  lane :upload_appstore_build do
    api_key = asc_api_key
    # lane_context는 같은 fastlane 실행 내에서만 유지되므로 별도 CI step에서는 고정 ipa 경로를 사용한다.
    ipa_output_path = lane_context[SharedValues::IPA_OUTPUT_PATH].to_s
    ipa_output_path = APPSTORE_IPA_OUTPUT_PATH if ipa_output_path.empty?

    UI.user_error!("Missing built ipa at #{ipa_output_path}") if !File.exist?(ipa_output_path)

    verify_store_info_plist(ipa: ipa_output_path)

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_output_path,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

end
