require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")
# pod install이 Xcode 27 형식의 Plyst.xcodeproj를 열고 저장할 수 있도록 먼저 등록
require_relative "../scripts/xcodeproj_xcode27"

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']

  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= podfile_properties['ios.buildReactNativeFromSource'] == 'true' ? '0' : '1'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= podfile_properties['ios.buildReactNativeFromSource'] == 'true' ? '0' : '1'
ENV['RCT_HERMES_V1_ENABLED'] ||= '0' if podfile_properties['expo.useHermesV1'] == 'false'
# 사전 컴파일 Expo 모듈은 쓰지 않는 모듈까지 별도 프레임워크로 실으므로 소스로 빌드
ENV['EXPO_USE_PRECOMPILED_MODULES'] = '0' if podfile_properties['EXPO_USE_PRECOMPILED_MODULES'] == 'false'
ENV['EXPO_USE_PRECOMPILED_MODULES'] ||= '1'
# ReactNativeBrownfield가 Expo 호스트로 React Native를 띄움
ENV['REACT_NATIVE_BROWNFIELD_USE_EXPO_HOST'] = '1'
platform :ios, podfile_properties['ios.deploymentTarget'] || '16.4'

project 'Plyst.xcodeproj'
workspace 'Plyst.xcworkspace'

prepare_react_native_project!

# React Native는 앱 타깃에만 링크
# Share Extension과 Widget Extension은 APPLICATION_EXTENSION_API_ONLY라 Pods에 넣지 않음
target 'Plyst' do
  use_expo_modules!

  config_command = [
    'node',
    '--no-warnings',
    '--eval',
    'require(\'expo/bin/autolinking\')',
    'expo-modules-autolinking',
    'react-native-config',
    '--json',
    '--platform',
    'ios'
  ]
  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  # 심볼은 TEST_HOST인 앱이 제공하므로 모듈 검색 경로만 상속
  target 'PlystTests' do
    inherit! :search_paths
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    # podspec에 Swift 버전이 없는 Pod은 앱 타깃의 Swift 6을 이어받아 동시성 검사에서 실패
    # Expo 앱 템플릿의 앱 타깃과 같은 Swift 5로 컴파일
    swift5_targets = installer.pod_targets.select { |pod_target| pod_target.uses_swift? && pod_target.root_spec.swift_versions.empty? }.map(&:name)
    installer.pods_project.targets.each do |target|
      next unless swift5_targets.include?(target.name)

      target.build_configurations.each { |build_configuration| build_configuration.build_settings['SWIFT_VERSION'] = '5.0' }
    end

    # ReactNativeBrownfield가 Expo SDK 55 이후 API를 쓰도록 하는 컴파일 조건
    brownfield_ios_deployment_target = podfile_properties['ios.deploymentTarget'] || '16.4'
    installer.pods_project.targets.each do |target|
      next unless target.name == 'ReactBrownfield'

      target.build_configurations.each do |build_configuration|
        conditions = (build_configuration.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] || '$(inherited)').to_s
        build_configuration.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] = "#{conditions} EXPO_SDK_GTE_55"
        build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = brownfield_ios_deployment_target
      end
    end

    # Xcode 26.4 이후 fmt 11.0.2의 consteval 컴파일 오류 우회
    fmt_base = File.join(installer.sandbox.pod_dir('fmt'), 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      content = File.read(fmt_base)
      patched = content.gsub(/^#\s*define FMT_USE_CONSTEVAL 1$/, '# define FMT_USE_CONSTEVAL 0')
      if patched != content
        File.chmod(0644, fmt_base)
        File.write(fmt_base, patched)
      end
    end
  end
end
