<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- 공유받은 이미지 URL을 내려받을 때 필요 -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Android 9 이하에서 사진 모음에 추가할 때만 필요 -->
  <uses-permission
    android:name="android.permission.WRITE_EXTERNAL_STORAGE"
    android:maxSdkVersion="28" />

  <application>
    <!-- 이미지 클립을 클립보드로 복사할 때 다른 앱이 읽을 URI를 제공 -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.plyst.clipboard"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/plyst_clipboard_paths" />
    </provider>

    <!-- 앱과 같은 프로세스에서 저장소를 공유 -->
    <!-- iOS Share Extension처럼 공유마다 새 화면을 열고 끝나면 보낸 앱으로 돌아감 -->
    <!-- 회전과 화면 모양 변경으로 다시 만들어지면 같은 항목을 또 저장하므로 직접 처리 -->
    <activity
      android:name="opfic.plyst.host.app.ShareActivity"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
      android:documentLaunchMode="always"
      android:excludeFromRecents="true"
      android:exported="true"
      android:theme="@style/PlystShareTheme">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
      </intent-filter>
    </activity>
  </application>
</manifest>
