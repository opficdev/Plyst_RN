{
  "expo": {
    "name": "PlystRN",
    "slug": "PlystRN",
    "version": "1.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.PlystRN"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "../Plyst/Plyst/Assets.xcassets/AppIcon.appiconset/AppIcon.png",
        "backgroundImage": "../Plyst/Plyst/Assets.xcassets/AppIcon.appiconset/AppIcon.png"
      },
      "package": "opfic.plyst",
      "version": "1.2",
      "versionCode": 1,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "@callstack/react-native-brownfield",
      [
        "expo-image",
        {
          "disableLibdav1d": true
        }
      ],
      "./plugins/withAndroidAssets",
      "./plugins/withAndroidMainActivity"
    ]
  }
}
